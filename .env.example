# Redis Configuration
# In production, separate broker (DB 0) and state/cache (DB 1) or use separate instances:
CELERY_BROKER_URL=redis://redis:6379/0
REDIS_URL=redis://redis:6379/0

# Central Retention Configuration (documented relationships):
# Clip files live at least as long as the job record; job record at least as long as user return window.
JOB_RECORD_TTL_SECONDS=86400
STATIC_RETENTION_HOURS=48.0
TEMP_DIR_CLEANUP_HOURS=4.0
CACHE_TRANSCRIPT_TTL_SECONDS=604800
CACHE_CANDIDATES_TTL_SECONDS=604800
S3_RETENTION_DAYS=7

LLM_API_KEY=your_api_key_here
LLM_MODEL=gemini-3.8-flash
GEMINI_MODEL=gemini-3.8-flash
TEMP_DIR=/tmp/clipper
ENVIRONMENT=development
STORAGE_BACKEND=local
STATIC_DIR=/app/static
PUBLIC_BASE_URL=http://localhost:8000
# S3 / Cloudflare R2 storage settings (required if STORAGE_BACKEND=s3):
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_NAME=
S3_PUBLIC_BASE_URL=
S3_URL_STYLE=public
S3_PRESIGNED_EXPIRY_SECONDS=604800
YTDLP_COOKIES_PATH=
